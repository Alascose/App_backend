generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categorie {
       id             Int @id @default(autoincrement())
       nom            String
       produit        Produit[]
       createdAt      DateTime @default(now())
}

model Produit {
       id              Int @id @default(autoincrement())
       nomProduit      String
       prixProduit     Float 
       quantiteStock   Int
       categorieId     Int 
       reapprovisionnement      Reapprovisionnement[]
       vente     Vente[]
       creance   Creance[]
       creanceSolde CreanceSolde[]
       detteRembourse DetteRembourse[]
       dette     Dette[]
       categorie Categorie @relation(fields: [categorieId] , references: [id])
       createdAt  DateTime @default(now())
}

model Reapprovisionnement {
      id             Int @id @default(autoincrement())
      produitId      Int
      quantite       Int
      createdAt            DateTime @default (now())
      produit Produit @relation(fields: [produitId], references: [id])
}

model Vente  {
      id         Int @id @default(autoincrement())
      clientId   Int
      produitId Int 
      quantite Int
      prixProduit Float
      montantTotal Float
      createdAt DateTime @default(now())
      produit Produit @relation(fields : [produitId], references : [id])
      client Client @relation(fields : [clientId] , references : [id])
}

model Client {
      id             Int @id @default(autoincrement())
      clientName     String
      clientTel      String ?
      clientEmail    String ?
      vente          Vente[]
      creance        Creance[]
      creanceSolde   CreanceSolde[]
      createdAt      DateTime @default(now())
}

model Creance {
      id            Int @id @default(autoincrement())
      produitId     Int
      clientId      Int 
      quantite      Int
      prixProduit   Float
      clientTel     String ?
      profession    String ?
      clientEmail   String ?
      montantTotal  Float 
      montantVerse  Float ?
      montantRestant Float ?
      statusCreance         String
      creanceSolde  CreanceSolde[]
      createdAt    DateTime @default(now())
      dateSolde    DateTime 
      produit Produit @relation(fields:[produitId] , references: [id])
      client Client @relation(fields: [clientId] , references : [id])
}

model CreanceSolde  {
      id           Int @id @default(autoincrement())
      creanceId    Int  
      produitId    Int 
      clientId     Int
      quantite     Int
      montantTotal Float ?
      montantVerse Float 
      montantRestant Float ?
      createdAt    DateTime @default(now())
      produit  Produit @relation(fields: [produitId] , references: [id])
      client Client @relation(fields:[clientId] , references:[id])
      creance Creance @relation(fields:[creanceId] , references:[id])
}

model Fournisseur {
     id             Int @id @default(autoincrement())
     nomFournisseur String  
     contact        String
     email          String
     siege          String ?
     dette     Dette[]
     detteRembourse DetteRembourse[]
     createdAt      DateTime @default(now())
}

model Dette {
     id             Int @id @default(autoincrement())
     fournisseurId  Int
     produitId      Int 
     quantite       Int 
     prixUnitaire   Float
     montant        Float
     montantRembourse Float ?
     montantReste   Float ?
     createdAt      DateTime @default(now())
     dateRembourse  DateTime
     statusDette    String
     detteRembourse DetteRembourse[]
     produit  Produit @relation(fields: [produitId] , references: [id])
     fournisseur Fournisseur @relation(fields: [fournisseurId] , references:[id])
}
model DetteRembourse {
     id            Int @id @default(autoincrement())
     detteId       Int
     fournisseurId Int 
     produitId     Int 
     quantite      Int
     montantDette  Float ?  
     prixUnitaire  Float
     montantRembourse Float
     montantReste  Float ?
     createdAt     DateTime @default(now())
     produit Produit @relation(fields: [produitId] , references: [id])
     fournisseur Fournisseur @relation(fields : [fournisseurId] , references: [id])
     dette Dette @relation(fields: [detteId] , references: [id])
}